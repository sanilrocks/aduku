// US5 and SPEC 6.7: a delete beats lower tiers and earlier writes, a later write at its tier or above re-creates the
// field, and deleting a struct removes its whole subtree.
case::{
  name: "tombstones",
  schema: schema::{
    id: "t", version: 1, tiers: [backfill, user, admin],
    fields: {
      "/phone": {type: string, merge: lww},
      "/age": {type: int, merge: max},
      "/address": {type: struct, merge: struct},
      "/address/city": {type: string, merge: lww},
      "/address/zip": {type: string, merge: lww}
    }
  },
  steps: [
    { append: { doc: "d1", contributor: {id: "job", tiers: [backfill]},
                entries: [{tier: backfill, path: "/phone", value: "555"}, {tier: backfill, path: "/age", value: 30},
                          {tier: backfill, path: "/address/zip", value: "78701"}] },
      expect: { accepted: [{seq: 1}, {seq: 2}, {seq: 3}] } },
    { append: { doc: "d1", contributor: {id: "alice", tiers: [user]}, entries: [{tier: user, path: "/address/city", value: "Rome"}] },
      expect: { accepted: [{seq: 4}] } },
    { get: "d1", expect: { document: '{address:{city:"Rome",zip:"78701"},age:30,phone:"555"}' } },

    // scenario 1: a delete from a higher tier removes the field
    { append: { doc: "d1", contributor: {id: "root", tiers: [admin]}, entries: [{tier: admin, path: "/phone", op: delete}] },
      expect: { accepted: [{seq: 5}] } },
    { get: "d1", expect: { document: '{address:{city:"Rome",zip:"78701"},age:30}' } },

    // scenario 2: a later write from a lower tier cannot revive it
    { append: { doc: "d1", contributor: {id: "job", tiers: [backfill]}, entries: [{tier: backfill, path: "/phone", value: "999"}] },
      expect: { accepted: [{seq: 6}] } },
    { get: "d1", expect: { document: '{address:{city:"Rome",zip:"78701"},age:30}' } },

    // scenario 3: the deleting tier can create it again
    { append: { doc: "d1", contributor: {id: "root", tiers: [admin]}, entries: [{tier: admin, path: "/phone", value: "777"}] },
      expect: { accepted: [{seq: 7}] } },
    { get: "d1", expect: { document: '{address:{city:"Rome",zip:"78701"},age:30,phone:"777"}' } },

    // scenario 4: deleting a struct removes the whole subtree; lower tiers cannot bring it back
    { append: { doc: "d1", contributor: {id: "root", tiers: [admin]}, entries: [{tier: admin, path: "/address", op: delete}] },
      expect: { accepted: [{seq: 8}] } },
    { append: { doc: "d1", contributor: {id: "job", tiers: [backfill]}, entries: [{tier: backfill, path: "/address/zip", value: "00000"}] },
      expect: { accepted: [{seq: 9}] } },
    { get: "d1", expect: { document: '{age:30,phone:"777"}' } },

    // a write beneath the deleted struct re-creates only what it writes
    { append: { doc: "d1", contributor: {id: "root", tiers: [admin]}, entries: [{tier: admin, path: "/address/city", value: "Paris"}] },
      expect: { accepted: [{seq: 10}] } },
    { get: "d1", expect: { document: '{address:{city:"Paris"},age:30,phone:"777"}' } },

    // a delete resets the rule: after it, max does not remember the 30 that was deleted
    { append: { doc: "d1", contributor: {id: "alice", tiers: [user]}, entries: [{tier: user, path: "/age", value: 5}] },
      expect: { accepted: [{seq: 11}] } },
    { append: { doc: "d1", contributor: {id: "root", tiers: [admin]}, entries: [{tier: admin, path: "/age", op: delete}] },
      expect: { accepted: [{seq: 12}] } },
    { append: { doc: "d1", contributor: {id: "alice", tiers: [user]}, entries: [{tier: user, path: "/age", value: 99}] },
      expect: { accepted: [{seq: 13}] } },
    { get: "d1", expect: { document: '{address:{city:"Paris"},phone:"777"}' } },
    { append: { doc: "d1", contributor: {id: "root", tiers: [admin]}, entries: [{tier: admin, path: "/age", value: 1}] },
      expect: { accepted: [{seq: 14}] } },
    { get: "d1", expect: { document: '{address:{city:"Paris"},age:1,phone:"777"}' } },

    // another document is unaffected
    { get: "d2", expect: { document: '{}' } }
  ]
}
