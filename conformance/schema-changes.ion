// Feature 006, US2: the class of each difference between two schema versions (docs/SPEC.md 14, the table of
// specs/006-schema-evolution/contracts/changes.md). Version 1 is the base; each other version differs from it (or from the named
// version) in the way its step says. The list is in (path, kind) order and the overall class is the worst of its classes.
case::{
  name: "schema-changes",
  fixtures: ["fx.echo@1", "fx.score@1"],
  schemas: [
    schema::{ id: "t", version: 1, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 2, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/extra": {type: string, merge: lww},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 3, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww} } },
    schema::{ id: "t", version: 4, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max, default: 0},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 5, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: min},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 6, tiers: [backfill, user, admin], 
              fields: { "/age": {type: decimal, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 7, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max, validate: [range::{min: 0, max: 150}]},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 8, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max, authority: [admin]},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 9, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, computed: {macro: upper, args: ["/name"]}} } },
    schema::{ id: "t", version: 10, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, on_missing: absent, computed: {macro: upper, args: ["/name"]}} } },
    schema::{ id: "t", version: 11, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww},
                        "/taxId": {type: string, computed: {impure: {hook: "fx.echo@1", depends: ["/name"], reason: "registry", timeout: "1s", retry: {max: 1, backoff: "10ms"}, deadline: "3s", recompute_by: [admin]}}} } },
    schema::{ id: "t", version: 12, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww},
                        "/taxId": {type: string, computed: {impure: {hook: "fx.echo@1", depends: ["/name"], reason: "registry", timeout: "1s", retry: {max: 2, backoff: "10ms"}, deadline: "3s", recompute_by: [admin]}}} } },
    schema::{ id: "t", version: 13, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww},
                        "/score": {type: int, deferred: {hook: "fx.score@1", depends: ["/name"], refresh: once, invalidate_by: [admin]}} } },
    schema::{ id: "t", version: 14, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww},
                        "/score": {type: int, deferred: {hook: "fx.score@1", depends: ["/name"], refresh: once, invalidate_by: [admin, user]}} } },
    schema::{ id: "t", version: 15, tiers: [backfill, user, admin, root], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 16, tiers: [backfill, extra, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 17, tiers: [backfill, user], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 18, tiers: [backfill, admin, user], 
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 19, tiers: [backfill, user, admin], roles: [dpo],
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 20, tiers: [backfill, user, admin], lenient: {allowed: [backfill]},
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 21, tiers: [backfill, user, admin], rejection_audit: {enabled: true, mode: full, retention: {max_entries: 10}},
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 22, tiers: [backfill, user, admin], document_validate: [at_least_one::{paths: ["/name", "/age"]}],
              fields: { "/age": {type: int, merge: max},
                        "/name": {type: string, merge: lww},
                        "/nick": {type: string, merge: lww} } },
    schema::{ id: "t", version: 23, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: min, default: 0},
                        "/extra": {type: string, merge: lww},
                        "/name": {type: string, merge: lww} } },
    schema::{ id: "t", version: 24, tiers: [backfill, user, admin], 
              fields: { "/age": {type: int, merge: max},
                        "/alias": {type: string, merge: lww},
                        "/name": {type: string, merge: lww} } }
  ],
  steps: [
    // a field added (plain, computed or deferred) is compatible (version 1 to 2)
    { diff: {old: 1, new: 2}, expect: { overall: compatible, changes: [{kind: field_added, path: "/extra", class: compatible, classified: true}] } },
    // a field removed is visible: its recorded values still show (version 1 to 3)
    { diff: {old: 1, new: 3}, expect: { overall: visible, changes: [{kind: field_removed, path: "/nick", class: visible, classified: true}] } },
    { diff: {old: 1, new: 4}, expect: { overall: visible, changes: [{kind: default_changed, path: "/age", class: visible, classified: true}] } },
    { diff: {old: 1, new: 5}, expect: { overall: breaking, changes: [{kind: merge_changed, path: "/age", class: breaking, classified: true}] } },
    { diff: {old: 1, new: 6}, expect: { overall: breaking, changes: [{kind: type_changed, path: "/age", class: breaking, classified: true}] } },
    { diff: {old: 1, new: 7}, expect: { overall: visible, changes: [{kind: validate_changed, path: "/age", class: visible, classified: true}] } },
    { diff: {old: 1, new: 8}, expect: { overall: visible, changes: [{kind: authority_changed, path: "/age", class: visible, classified: true}] } },
    // plain becomes computed: breaking (version 1 to 9)
    { diff: {old: 1, new: 9}, expect: { overall: breaking, changes: [{kind: became_derived, path: "/nick", class: breaking, classified: true}] } },
    // computed becomes plain: breaking (version 9 to 1)
    { diff: {old: 9, new: 1}, expect: { overall: breaking, changes: [{kind: became_plain, path: "/nick", class: breaking, classified: true}] } },
    { diff: {old: 9, new: 10}, expect: { overall: visible, changes: [{kind: computed_changed, path: "/nick", class: visible, classified: true}] } },
    { diff: {old: 11, new: 12}, expect: { overall: visible, changes: [{kind: impure_changed, path: "/taxId", class: visible, classified: true}] } },
    { diff: {old: 13, new: 14}, expect: { overall: visible, changes: [{kind: deferred_changed, path: "/score", class: visible, classified: true}] } },
    { diff: {old: 1, new: 15}, expect: { overall: compatible, changes: [{kind: tier_added_top, path: "root", class: compatible, classified: true}] } },
    { diff: {old: 1, new: 16}, expect: { overall: breaking, changes: [{kind: tier_changed, path: "extra", class: breaking, classified: true}] } },
    { diff: {old: 1, new: 17}, expect: { overall: breaking, changes: [{kind: tier_changed, path: "admin", class: breaking, classified: true}] } },
    { diff: {old: 1, new: 18}, expect: { overall: breaking, changes: [{kind: tier_changed, path: "admin", class: breaking, classified: true}, {kind: tier_changed, path: "user", class: breaking, classified: true}] } },
    { diff: {old: 1, new: 19}, expect: { overall: compatible, changes: [{kind: roles_added, path: "dpo", class: compatible, classified: true}] } },
    { diff: {old: 1, new: 20}, expect: { overall: visible, changes: [{kind: settings_changed, path: "", class: visible, classified: true}] } },
    { diff: {old: 1, new: 21}, expect: { overall: compatible, changes: [{kind: audit_changed, path: "", class: compatible, classified: true}] } },
    { diff: {old: 1, new: 22}, expect: { overall: visible, changes: [{kind: document_validate_changed, path: "", class: visible, classified: true}] } },
    // several changes at once, each its own entry; the overall class is the worst (version 1 to 23)
    { diff: {old: 1, new: 23}, expect: { overall: breaking, changes: [{kind: default_changed, path: "/age", class: visible, classified: true}, {kind: merge_changed, path: "/age", class: breaking, classified: true}, {kind: field_added, path: "/extra", class: compatible, classified: true}, {kind: field_removed, path: "/nick", class: visible, classified: true}] } },
    // a renamed field is a removal and an addition (version 1 to 24)
    { diff: {old: 1, new: 24}, expect: { overall: visible, changes: [{kind: field_added, path: "/alias", class: compatible, classified: true}, {kind: field_removed, path: "/nick", class: visible, classified: true}] } },
    // the same version twice: nothing changed (version 1 to 1)
    { diff: {old: 1, new: 1}, expect: { overall: compatible, changes: [] } },
    // asked again: the same list in the same order (version 1 to 5)
    { diff: {old: 1, new: 5}, expect: { overall: breaking, changes: [{kind: merge_changed, path: "/age", class: breaking, classified: true}] } }
  ]
}
